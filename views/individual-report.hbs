<style>
    /* Dark Theme Core */
    .card-report { background: #161922; border: 1px solid #33394d; border-radius: 15px; padding: 30px; }
    
    /* Table Styling */
    .table-record { background-color: #161922 !important; border: 1px solid #33394d; color: white !important; width: 100%; border-collapse: separate; }
    .table-record thead th { background-color: #1f232d; color: var(--accent-color); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; border-bottom: 2px solid #33394d; padding: 15px; }
    .table-record tbody td { background-color: #161922; border-bottom: 1px solid #33394d; color: #ffffff !important; padding: 12px 15px; vertical-align: middle; }
    
    /* Highlight States */
    .total-footer td { background-color: #1f232d !important; font-weight: bold; color: var(--accent-color) !important; border-top: 2px solid var(--accent-color); padding: 15px; }
    .badge-check { background: rgba(0, 255, 136, 0.1); color: #00ff88; border: 1px solid #00ff88; padding: 4px 10px; border-radius: 5px; font-size: 0.8rem; font-weight: bold; }
    
    /* Select Inputs */
    .form-select-dark { background-color: #1f232d !important; border: 1px solid #33394d !important; color: #ffffff !important; }
    
    @media print {
        .no-print { display: none; }
        .card-report { border: none; padding: 0; }
        body { background: white; color: black; }
    }
</style>

<div class="container py-4">
    <div class="row mb-4 align-items-end g-3 no-print">
        <div class="col-md-5">
            <label class="text-secondary small d-block mb-1">Select Member:</label>
            <input type="text" id="memberSearch" class="form-control form-control-sm mb-2" placeholder="Search by name..." style="background-color: #1f232d; color: white; border: 1px solid #33394d;">
            <select id="memberSelector" class="form-select form-select-dark">
                {{#each allMembers}}
                    <option value="{{this._id}}" {{#if (eq this._id ../member._id)}}selected{{/if}}>
                        {{this.firstName}} {{this.lastName}} ({{this.group}})
                    </option>
                {{/each}}
            </select>
        </div>
        <div class="col-md-3">
            <label class="text-secondary small d-block mb-1">Service Year:</label>
            <select id="yearSelector" class="form-select form-select-dark">
                <option value="2025" {{#if (eq serviceYear 2025)}}selected{{/if}}>2024-2025</option>
                <option value="2026" {{#if (eq serviceYear 2026)}}selected{{/if}}>2025-2026</option>
                <option value="2027" {{#if (eq serviceYear 2027)}}selected{{/if}}>2026-2027</option>
            </select>
        </div>
        <div class="col-md-4 text-md-end">
            <button onclick="window.print()" class="btn btn-outline-light">
                <i class="fas fa-print me-2"></i> Print Card
            </button>
        </div>
    </div>

    <div class="card-report">
        <div class="row mb-4">
            <div class="col-6">
                <h2 class="text-white mb-0">{{member.firstName}} {{member.lastName}}</h2>
                <div class="text-accent fw-bold">{{formatType member.type}}</div>
                <div class="text-secondary small">Group: {{member.group}}</div>
            </div>
            <div class="col-6 text-end">
                <div class="text-secondary small text-uppercase letter-spacing-1">Service Year</div>
                <h3 class="text-white">{{subtract serviceYear 1}}-{{serviceYear}}</h3>
            </div>
        </div>

        <div class="table-responsive">
            <form id="bulkUpdateForm">
                <input type="hidden" id="memberId" value="{{member._id}}">
                <table class="table table-record align-middle">
                <thead>
                    <tr>
                        <th style="width: 20%;">Month</th>
                        <th class="text-center">Participated</th>
                        {{#if isPioneer}}
                        <th class="text-center">Hours</th>
                        {{/if}}
                        <th class="text-center">Bible Studies</th>
                        <th>Remarks</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each yearlyData}}
                    <tr>
                        <td class="fw-bold text-white">
                            {{this.month}}
                            <input type="hidden" name="reports[{{@index}}][month]" value="{{this.month}}">
                            <input type="hidden" name="reports[{{@index}}][year]" value="{{this.year}}">
                        </td>
                        <td class="text-center">
                            <div class="form-check d-flex justify-content-center">
                                <input class="form-check-input" type="checkbox" name="reports[{{@index}}][participated]" {{#if this.participated}}checked{{/if}}>
                            </div>
                        </td>
                        {{#if ../isPioneer}}
                        <td class="text-center">
                            <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary text-center" name="reports[{{@index}}][hours]" value="{{this.hours}}" min="0" style="width: 80px; margin: 0 auto;">
                        </td>
                        {{/if}}
                        <td class="text-center">
                            <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary text-center" name="reports[{{@index}}][bibleStudies]" value="{{this.bibleStudies}}" min="0" style="width: 80px; margin: 0 auto;">
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" name="reports[{{@index}}][remarks]" value="{{this.remarks}}">
                        </td>
                        <td class="text-center no-print">
                            <!-- Live edit, no action button per row needed -->
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
                <tfoot>
                    <tr class="total-footer">
                        <td>TOTALS</td>
                        <td class="text-center">{{totals.monthsActive}} Months</td>
                        {{#if isPioneer}}
                        <td class="text-center">{{totals.hours}}</td>
                        {{/if}}
                        <td class="text-center">{{totals.studies}}</td>
                        <td></td>
                        <td class="no-print"></td>
                    </tr>
                </tfoot>
            </table>
            <div class="text-end mt-3 no-print">
                <button type="button" id="saveBulkBtn" class="btn btn-primary bg-accent text-dark border-0 fw-bold px-4 py-2">
                    <i class="fas fa-save me-2"></i> Save All Changes
                </button>
            </div>
            </form>
        </div>
    </div>
</div>

<script>
    window.addEventListener('load', function() {
        // Navigation logic for filters
        const memberSelect = document.getElementById('memberSelector');
        const yearSelect = document.getElementById('yearSelector');

        if (memberSelect && yearSelect) {
            function updateView() {
                const mId = memberSelect.value;
                const year = yearSelect.value;
                window.location.href = `/reports/individual/${mId}?year=${year}`;
            }

            memberSelect.addEventListener('change', updateView);
            yearSelect.addEventListener('change', updateView);
        }

        // Member Search Filter Logic (DOM based)
        const memberSearch = document.getElementById('memberSearch');
        if (memberSearch && memberSelect) {
            // Store original selected index to restore if search cleared
            const originalSelectedIndex = memberSelect.selectedIndex;
            
            memberSearch.addEventListener('input', function() {
                const term = this.value.toLowerCase();
                const options = memberSelect.options;
                
                // If searching, unselect to allow clicking the single result
                if (term.length > 0) {
                    memberSelect.selectedIndex = -1;
                } else {
                    memberSelect.selectedIndex = originalSelectedIndex;
                }

                for (let i = 0; i < options.length; i++) {
                    const text = options[i].textContent.toLowerCase();
                    options[i].style.display = text.includes(term) ? '' : 'none';
                }
            });
        }

        // Bulk Edit Logic
        const saveBulkBtn = document.getElementById('saveBulkBtn');
        const bulkUpdateForm = document.getElementById('bulkUpdateForm');
        const memberId = document.getElementById('memberId').value;

        if (saveBulkBtn && bulkUpdateForm) {
            saveBulkBtn.addEventListener('click', async function() {
                saveBulkBtn.disabled = true;
                saveBulkBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Saving...';

                try {
                    const formData = new FormData(bulkUpdateForm);
                    const rawData = Object.fromEntries(formData.entries());
                    
                    // Parse form data into an array of report objects
                    const reportsArray = [];
                    // We know there are exactly 12 months in the form loop
                    for (let i = 0; i < 12; i++) {
                        // Check if the month exists in the form to safely parse
                        if (rawData[`reports[${i}][month]`]) {
                            reportsArray.push({
                                month: rawData[`reports[${i}][month]`],
                                year: rawData[`reports[${i}][year]`],
                                participated: rawData[`reports[${i}][participated]`] === 'on',
                                hours: rawData[`reports[${i}][hours]`],
                                bibleStudies: rawData[`reports[${i}][bibleStudies]`],
                                remarks: rawData[`reports[${i}][remarks]`]
                            });
                        }
                    }

                    const response = await fetch(`/reports/individual/${memberId}/bulk-update`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reports: reportsArray })
                    });

                    const result = await response.json();
                    if (result.success) {
                        // Reload to recalculate totals and show fresh data
                        location.reload();
                    } else {
                        alert(result.message || "Error saving reports");
                        saveBulkBtn.disabled = false;
                        saveBulkBtn.innerHTML = '<i class="fas fa-save me-2"></i> Save All Changes';
                    }
                } catch (err) {
                    console.error(err);
                    alert("An error occurred. Please try again.");
                    saveBulkBtn.disabled = false;
                    saveBulkBtn.innerHTML = '<i class="fas fa-save me-2"></i> Save All Changes';
                }
            });
        }
    });
</script>