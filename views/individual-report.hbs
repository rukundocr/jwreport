<style>
    /* Dark Theme Core */
    .card-report { background: #161922; border: 1px solid #33394d; border-radius: 15px; padding: 30px; }
    
    /* Table Styling */
    .table-record { background-color: #161922 !important; border: 1px solid #33394d; color: white !important; width: 100%; border-collapse: separate; }
    .table-record thead th { background-color: #1f232d; color: var(--accent-color); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; border-bottom: 2px solid #33394d; padding: 15px; }
    .table-record tbody td { background-color: #161922; border-bottom: 1px solid #33394d; color: #ffffff !important; padding: 12px 15px; vertical-align: middle; }
    
    /* Highlight States */
    .total-footer td { background-color: #1f232d !important; font-weight: bold; color: var(--accent-color) !important; border-top: 2px solid var(--accent-color); padding: 15px; }
    .badge-check { background: rgba(0, 255, 136, 0.1); color: #00ff88; border: 1px solid #00ff88; padding: 4px 10px; border-radius: 5px; font-size: 0.8rem; font-weight: bold; }
    
    /* Select Inputs */
    .form-select-dark { background-color: #1f232d !important; border: 1px solid #33394d !important; color: #ffffff !important; }
    
    @media print {
        .no-print { display: none; }
        .card-report { border: none; padding: 0; }
        body { background: white; color: black; }
    }
</style>

<div class="container py-4">
    <div class="row mb-4 align-items-end g-3 no-print">
        <div class="col-md-5">
            <label class="text-secondary small d-block mb-1">Select Member:</label>
            <select id="memberSelector" class="form-select form-select-dark">
                {{#each allMembers}}
                    <option value="{{this._id}}" {{#if (eq this._id ../member._id)}}selected{{/if}}>
                        {{this.firstName}} {{this.lastName}} ({{this.group}})
                    </option>
                {{/each}}
            </select>
        </div>
        <div class="col-md-3">
            <label class="text-secondary small d-block mb-1">Service Year:</label>
            <select id="yearSelector" class="form-select form-select-dark">
                <option value="2025" {{#if (eq serviceYear 2025)}}selected{{/if}}>2024-2025</option>
                <option value="2026" {{#if (eq serviceYear 2026)}}selected{{/if}}>2025-2026</option>
                <option value="2027" {{#if (eq serviceYear 2027)}}selected{{/if}}>2026-2027</option>
            </select>
        </div>
        <div class="col-md-4 text-md-end">
            <button onclick="window.print()" class="btn btn-outline-light">
                <i class="fas fa-print me-2"></i> Print Card
            </button>
        </div>
    </div>

    <div class="card-report">
        <div class="row mb-4">
            <div class="col-6">
                <h2 class="text-white mb-0">{{member.firstName}} {{member.lastName}}</h2>
                <div class="text-accent fw-bold">{{formatType member.type}}</div>
                <div class="text-secondary small">Group: {{member.group}}</div>
            </div>
            <div class="col-6 text-end">
                <div class="text-secondary small text-uppercase letter-spacing-1">Service Year</div>
                <h3 class="text-white">{{subtract serviceYear 1}}-{{serviceYear}}</h3>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-record align-middle">
                <thead>
                    <tr>
                        <th style="width: 20%;">Month</th>
                        <th class="text-center">Participated</th>
                        {{#if isPioneer}}
                        <th class="text-center">Hours</th>
                        {{/if}}
                        <th class="text-center">Bible Studies</th>
                        <th>Remarks</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each yearlyData}}
                    <tr>
                        <td class="fw-bold text-white">{{this.month}}</td>
                        <td class="text-center">
                            {{#if this.participated}}
                                <span class="badge-check">YES</span>
                            {{else if this.hasRecord}}
                                <span class="text-danger small fw-bold">NO</span>
                            {{else}}
                                <span class="text-muted small">---</span>
                            {{/if}}
                        </td>
                        {{#if ../isPioneer}}
                        <td class="text-center fw-bold text-white">{{this.hours}}</td>
                        {{/if}}
                        <td class="text-center text-white">{{this.bibleStudies}}</td>
                        <td class="text-secondary small">{{this.remarks}}</td>
                        <td class="text-center no-print">
                            {{#if this.hasRecord}}
                                <button class="btn btn-sm btn-outline-accent edit-btn" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#editReportModal"
                                        data-id="{{this._id}}" 
                                        data-month="{{this.month}}"
                                        data-year="{{this.year}}"
                                        data-participated="{{this.participated}}"
                                        data-hours="{{this.hours}}"
                                        data-studies="{{this.bibleStudies}}"
                                        data-remarks="{{this.remarks}}">
                                    <i class="fas fa-edit"></i>
                                </button>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
                <tfoot>
                    <tr class="total-footer">
                        <td>TOTALS</td>
                        <td class="text-center">{{totals.monthsActive}} Months</td>
                        {{#if isPioneer}}
                        <td class="text-center">{{totals.hours}}</td>
                        {{/if}}
                        <td class="text-center">{{totals.studies}}</td>
                        <td></td>
                        <td class="no-print"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Edit Report Modal -->
<div class="modal fade" id="editReportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white">Edit Monthly Report</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editReportForm">
                <div class="modal-body">
                    <input type="hidden" id="editReportId" name="reportId">
                    
                    <div class="mb-3 text-center">
                        <h4 class="text-accent" id="editMonthYear">Month Year</h4>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="editParticipated" name="participated">
                        <label class="form-check-label text-white" for="editParticipated">Participated in ministry?</label>
                    </div>

                    <div class="mb-3">
                        <label class="text-secondary small mb-1">Hours</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary" id="editHours" name="hours" min="0">
                    </div>

                    <div class="mb-3">
                        <label class="text-secondary small mb-1">Bible Studies</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary" id="editStudies" name="bibleStudies" min="0">
                    </div>

                    <div class="mb-3">
                        <label class="text-secondary small mb-1">Remarks</label>
                        <textarea class="form-control bg-dark text-white border-secondary" id="editRemarks" name="remarks" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary bg-accent text-dark border-0 fw-bold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    window.addEventListener('load', function() {
        // Navigation logic for filters
        const memberSelect = document.getElementById('memberSelector');
        const yearSelect = document.getElementById('yearSelector');

        if (memberSelect && yearSelect) {
            function updateView() {
                const mId = memberSelect.value;
                const year = yearSelect.value;
                window.location.href = `/reports/individual/${mId}?year=${year}`;
            }

            memberSelect.addEventListener('change', updateView);
            yearSelect.addEventListener('change', updateView);
        }

        // Edit Modal Logic
        const editModalEl = document.getElementById('editReportModal');
        if (!editModalEl) return;

        const editForm = document.getElementById('editReportForm');
        
        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('editReportId').value = this.dataset.id || '';
                document.getElementById('editMonthYear').textContent = `${this.dataset.month} ${this.dataset.year}`;
                document.getElementById('editParticipated').checked = this.dataset.participated === 'true';
                document.getElementById('editHours').value = this.dataset.hours || 0;
                document.getElementById('editStudies').value = this.dataset.studies || 0;
                document.getElementById('editRemarks').value = this.dataset.remarks || '';
            });
        });

        if (editForm) {
            editForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const data = Object.fromEntries(formData.entries());
                data.participated = document.getElementById('editParticipated').checked ? 'on' : 'off';

                try {
                    const response = await fetch('/reports/update', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();
                    if (result.success) {
                        location.reload();
                    } else {
                        alert(result.message || "Error updating report");
                    }
                } catch (err) {
                    console.error(err);
                    alert("An error occurred. Please try again.");
                }
            });
        }
    });
</script>