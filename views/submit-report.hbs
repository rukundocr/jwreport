<style>
    /* Table Styling */
    .table-dark-custom {
        background-color: #161922 !important;
        color: #ffffff !important;
        border-radius: 12px;
        overflow: hidden;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }

    .table-dark-custom thead th {
        background-color: #1f232d;
        color: var(--accent-color);
        padding: 15px;
        border-bottom: 2px solid #33394d;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    .table-dark-custom tbody td {
        background-color: #161922;
        border-bottom: 1px solid #33394d;
        padding: 12px 15px;
    }

    /* Input Styles */
    .form-control-sm-dark {
        background-color: #1f232d !important;
        border: 1px solid #33394d !important;
        color: #ffffff !important;
        text-align: center;
        border-radius: 4px;
    }

    /* Checkbox Styling */
    .form-check-input {
        background-color: #1f232d;
        border-color: #33394d;
        width: 1.4em;
        height: 1.4em;
        cursor: pointer;
    }
    .form-check-input:checked {
        background-color: var(--accent-color);
        border-color: var(--accent-color);
    }

    .card-custom {
        background: #161922;
        border: 1px solid #33394d;
        border-radius: 12px;
        padding: 20px;
    }

    /* Badge for Publisher Type */
    .publisher-type-label {
        color: var(--accent-color);
        font-size: 0.75rem;
        font-weight: 600;
        opacity: 0.9;
        text-transform: capitalize;
    }

    .reporting-row { transition: all 0.3s ease; }
    .reporting-row.active-row { background-color: rgba(187, 134, 252, 0.05) !important; }
</style>

<div class="card-custom mb-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="m-0 text-white">Submit Monthly Reports</h2>
            <p class="text-secondary small mb-0">Record activity status for pending publishers</p>
        </div>
        <span class="badge bg-dark text-accent border border-secondary p-2">Session Year: {{selectedYear}}</span>
    </div>
    
    <form action="/reports/submit" method="GET" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="small text-secondary mb-1">Select Group</label>
            <select name="group" class="form-select bg-dark text-white border-secondary" onchange="this.form.submit()">
                <option value="">-- Choose Group --</option>
                <option value="CYARUZINGE" {{#if (eq selectedGroup 'CYARUZINGE')}}selected{{/if}}>CYARUZINGE</option>
                <option value="GISURA" {{#if (eq selectedGroup 'GISURA')}}selected{{/if}}>GISURA</option>
                <option value="RUDASHYA CENTRE" {{#if (eq selectedGroup 'RUDASHYA CENTRE')}}selected{{/if}}>RUDASHYA CENTRE</option>
                <option value="RUDASHYA" {{#if (eq selectedGroup 'RUDASHYA')}}selected{{/if}}>RUDASHYA</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="small text-secondary mb-1">Month</label>
            <select name="month" id="monthSelect" class="form-select bg-dark text-white border-secondary">
                <option value="January" {{#if (eq selectedMonth 'January')}}selected{{/if}}>January</option>
                <option value="February" {{#if (eq selectedMonth 'February')}}selected{{/if}}>February</option>
                <option value="March" {{#if (eq selectedMonth 'March')}}selected{{/if}}>March</option>
                <option value="April" {{#if (eq selectedMonth 'April')}}selected{{/if}}>April</option>
                <option value="May" {{#if (eq selectedMonth 'May')}}selected{{/if}}>May</option>
                <option value="June" {{#if (eq selectedMonth 'June')}}selected{{/if}}>June</option>
                <option value="July" {{#if (eq selectedMonth 'July')}}selected{{/if}}>July</option>
                <option value="August" {{#if (eq selectedMonth 'August')}}selected{{/if}}>August</option>
                <option value="September" {{#if (eq selectedMonth 'September')}}selected{{/if}}>September</option>
                <option value="October" {{#if (eq selectedMonth 'October')}}selected{{/if}}>October</option>
                <option value="November" {{#if (eq selectedMonth 'November')}}selected{{/if}}>November</option>
                <option value="December" {{#if (eq selectedMonth 'December')}}selected{{/if}}>December</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="small text-secondary mb-1">Service Year</label>
            <select name="year" id="yearSelect" class="form-select bg-dark text-white border-secondary">
                <option value="2025" {{#if (eq selectedYear '2025')}}selected{{/if}}>2025</option>
                <option value="2026" {{#if (eq selectedYear '2026')}}selected{{/if}}>2026</option>
                <option value="2027" {{#if (eq selectedYear '2027')}}selected{{/if}}>2027</option>
                <option value="2026" {{#if (eq selectedYear '2026')}}selected{{/if}}>2028</option>
                <option value="2027" {{#if (eq selectedYear '2027')}}selected{{/if}}>2029</option>
            </select>
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-light w-100">
                <i class="fas fa-search me-2"></i> Load Pending
            </button>
        </div>
    </form>
</div>

{{#if members.length}}
<form action="/reports/submit-bulk" method="POST">
    <input type="hidden" name="month" value="{{selectedMonth}}">
    <input type="hidden" name="year" value="{{selectedYear}}">

    <div class="card-custom p-0" style="border:none;">
        <div class="table-responsive">
            <table class="table table-dark-custom m-0">
                <thead>
                    <tr>
                        <th style="width: 25%;">Publisher</th>
                        <th class="text-center">Reported?</th>
                        <th class="text-center">Participated?</th>
                        <th class="text-center">Hours</th>
                        <th class="text-center">Studies</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each members}}
                    <tr class="align-middle reporting-row">
                        <td>
                            <div class="fw-bold text-white mb-0" style="font-size: 1rem;">{{this.firstName}} {{this.lastName}}</div>
                            <div class="publisher-type-label">
                                <i class="fas fa-user-tag me-1 small"></i>{{formatType this.type}}
                            </div>
                        </td>
                        <td class="text-center">
                            <input type="checkbox" name="reports[{{this._id}}][reported]" class="form-check-input report-toggle">
                        </td>
                        <td class="text-center">
                            <input type="checkbox" name="reports[{{this._id}}][participated]" class="form-check-input participation-toggle">
                        </td>
                        <td>
                            <input type="number" name="reports[{{this._id}}][hours]" 
                                   class="form-control form-control-sm-dark mx-auto hour-input" 
                                   style="width: 75px;" placeholder="0">
                        </td>
                        <td>
                            <input type="number" name="reports[{{this._id}}][bibleStudies]" 
                                   class="form-control form-control-sm-dark mx-auto" 
                                   style="width: 75px;" value="0">
                        </td>
                        <td>
                            <input type="text" name="reports[{{this._id}}][remarks]" 
                                   class="form-control form-control-sm-dark text-start w-100" 
                                   placeholder="Notes...">
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        
        <div class="mt-4">
            <button type="submit" class="btn btn-primary btn-lg w-100" 
                    style="background: var(--accent-color); color: #000; border: none; font-weight: 800; padding: 15px;">
                <i class="fas fa-save me-2"></i> SUBMIT {{members.length}} PENDING RECORDS
            </button>
        </div>
    </div>
</form>

<script>
    document.querySelectorAll('.reporting-row').forEach(row => {
        const reportToggle = row.querySelector('.report-toggle');
        const participationToggle = row.querySelector('.participation-toggle');
        const hourInput = row.querySelector('.hour-input');

        hourInput.addEventListener('input', function() {
            if (this.value > 0) {
                reportToggle.checked = true;
                participationToggle.checked = true;
                row.classList.add('active-row');
            }
        });

        participationToggle.addEventListener('change', function() {
            if (this.checked) {
                reportToggle.checked = true;
                row.classList.add('active-row');
            }
        });

        reportToggle.addEventListener('change', function() {
            if (this.checked) {
                row.classList.add('active-row');
            } else {
                row.classList.remove('active-row');
                participationToggle.checked = false;
                hourInput.value = '';
            }
        });
    });

    // Auto-select current month/year on first load
    window.addEventListener('DOMContentLoaded', () => {
        const monthSelect = document.getElementById('monthSelect');
        const yearSelect = document.getElementById('yearSelect');
        const now = new Date();
        
        if (!monthSelect.value) {
            monthSelect.value = now.toLocaleString('default', { month: 'long' });
        }
        if (!yearSelect.value) {
            yearSelect.value = now.getFullYear();
        }
    });
</script>

{{else if selectedGroup}}
<div class="card-custom text-center py-5 mt-4">
    <div class="mb-3"><i class="fas fa-check-circle fa-3x text-success"></i></div>
    <h5 class="text-white">All reports for {{selectedGroup}} are Recorded!</h5>
    <p class="text-secondary">No missing reports for {{selectedMonth}} {{selectedYear}}.</p>
    <a href="/reports/view?month={{selectedMonth}}&year={{selectedYear}}" class="btn btn-sm btn-outline-accent">Go to Records</a>
</div>
{{/if}}